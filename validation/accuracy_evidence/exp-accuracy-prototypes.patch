diff --git a/src/qes_core/dtcc/api/experiment.h b/src/qes_core/dtcc/api/experiment.h
new file mode 100644
index 0000000..6fdc175
--- /dev/null
+++ b/src/qes_core/dtcc/api/experiment.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace dtcc_qes {
+// Experiment switches of ACCURACY_IMPROVEMENT_PLAN.md (branch exp/accuracy-prototypes only).
+// Read from the environment at every call; unset means the released behaviour, bit for bit.
+inline double experimentValue(const char *name, double fallback)
+{
+  const char *text = std::getenv(name);
+  return text && *text ? std::atof(text) : fallback;
+}
+
+// Part M: weight of a zone that used to switch on inside ``tol`` of the aligned direction.
+// ``deviation`` is the angle from alignment (radians, >= 0). With a half-width h > 0 the weight is 1
+// up to tol - h and falls by a smoothstep to 0 at tol + h; ``inside`` is the released test (h = 0).
+inline float angleFadeWeight(float deviation, float tol, bool inside)
+{
+  const float h = float(experimentValue("QES_EXP_ANGLE_FADE", 0.0) * 3.14159265358979323846 / 180.0);
+  if (h <= 0.0f) return inside ? 1.0f : 0.0f;
+  const float t = std::clamp((tol + h - deviation) / (2.0f * h), 0.0f, 1.0f);
+  return t * t * (3.0f - 2.0f * t);
+}
+}
